# ========================================
# OpenRouter API Configuration
# ========================================
# Obtenha sua chave em: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free


# ========================================
# LangChain Debug Mode (opcional)
# ========================================
# Defina como "true" para ver logs detalhados do LangChain
LANGCHAIN_DEBUG=False

# ========================================
# CrewAI Configuration (opcional)
# ========================================
CREW_VERBOSE=False

# ========================================
# Extra CA bundle (optional)
# ========================================
# PEM file with extra roots, for antivirus or corporate proxies that inspect
# TLS. Certificate verification stays enabled.
# DAVINCI_CA_BUNDLE=C:/path/to/cacert-extra.pem
